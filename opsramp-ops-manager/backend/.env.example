# OpsRamp API (from Setup > Integrations > your OAuth integration)
OPSRAMP_API_ENDPOINT=https://api.opsramp.com
OPSRAMP_KEY=
OPSRAMP_SECRET=
OPSRAMP_TENANT_ID=

# Set to true to run without OpsRamp credentials (simulated data)
OPSRAMP_MOCK=true

# App login (change before production)
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=changeme
APP_SECRET_KEY=dev-secret-change-in-production

# SQLite audit log path (relative to backend/)
AUDIT_DB_PATH=audit.db
